{
  "name": "featjar-extension",
  "displayName": "FeatJAR Extension",
  "description": "Provides tools for creating, editing, and analyzing FeatJAR feature models in Visual Studio Code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "featjar-extension.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "featjar-extension.hellovscode",
        "title": "Hello VSCode"
      },
      {
        "command": "featjar-extension.checkSatisfiability",
        "title": "FeatJAR: Check Satisfiability"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "featjar-extension.checkSatisfiability",
          "when": "resourceExtname == .uvl"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
